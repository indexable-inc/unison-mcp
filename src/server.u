-- Server: an MCP server (stdio) that exposes ONE tool, `unison`, and proxies it to the many tools of
-- `ucm mcp` running as a supervised child process. See Server.main for the environment it reads.

unique type Server.Config = Config Text Text Text Text Nat

Server.Config.ucm : Server.Config -> Text
Server.Config.ucm = cases Server.Config.Config u _ _ _ _ -> u

Server.Config.codebase : Server.Config -> Text
Server.Config.codebase = cases Server.Config.Config _ c _ _ _ -> c

Server.Config.project : Server.Config -> Text
Server.Config.project = cases Server.Config.Config _ _ p _ _ -> p

Server.Config.branch : Server.Config -> Text
Server.Config.branch = cases Server.Config.Config _ _ _ b _ -> b

Server.Config.timeoutMs : Server.Config -> Nat
Server.Config.timeoutMs = cases Server.Config.Config _ _ _ _ t -> t

-- isError (infrastructure failure: timeout, dead child), text
unique type Server.Out = Out Boolean Text

Server.env : Text -> Text ->{IO} Text
Server.env k d = match Exception.catch do IO.getEnv k with
  Right v -> if Text.size v == 0 then d else v
  Left _ -> d

-- ---------- the tool ----------

Server.toolName : Text
Server.toolName = "unison"

Server.description : Text
Server.description = Text.join "\n" [
  "Unison REPL, general MCP client and Chrome driver. Action 'run' executes Unison (ucm 1.5) code in a local codebase (code = the body of a do block of type '{IO, Exception} a), so everything below is a one-line cell; never conclude Unison cannot do it.",
  "Cells: MCP client for any server in ~/.local/share/uni/mcp/servers.json (stdio or HTTP, OAuth sign-in with a browser pop-up): Mcp.login \"x\" ; Mcp.run do Mcp.call \"x\" \"tool\" \"{\\\"k\\\":1}\" ; Mcp.run do Mcp.toolNames \"x\". Chrome over CDP: Cdp.connect Cdp.endpoint \"github.com\" do !Cdp.readPage (also Cdp.navigate, eval, click, typeText, screenshot). Processes: (i, o, e, p) = Process.start \"git\" [\"status\"] then getText o. HTTP: Threads.run do Http.run do HttpResponse.bodyText (Http.get (URI.parse \"https://example.com\")).",
  "Actions: check (default: typecheck 'code'; '> expr' and 'test>' lines run), run (code; or 'name' of a committed definition with 'args'; code that has definitions ends with one '> expr' line), update, view, search, type-search, install, docs, tests, diff, guide, tools, tool (raw ucm tool: 'name', 'json').",
  "Replies start with 'stage:', 'ok:', 'class:' (wrong-name, ambiguous-name, type-mismatch, unhandled-ability, parse-error, usage, timeout, child-died, none). A result over ~12k characters is cut to head and tail; the full text is in a file whose path is returned.",
  "Traps: (1) look up library names first with action 'search'; guessing is the top error. (2) Named functions are never infix: Nat.mod a b. (3) Function first: List.foreach printLine xs. (4) Compile errors are data and ucm exits 0 anyway: read 'ok:'. (5) Give each program a unique name; run can pick an older committed one.",
  "Action 'guide' (optional 'topic': unison-basics, http-json, mcp-client, oauth, cdp, process-ffi, traps) returns the full cheat sheet."]

Server.schema : Json
Server.schema =
  str d = Json.Object [("type", Json.Text "string"), ("description", Json.Text d)]
  actions = Json.Array (List.map Json.Text ["check", "run", "update", "view", "search", "type-search", "install", "docs", "tests", "diff", "guide", "tools", "tool"])
  Json.Object [
    ("type", Json.Text "object"),
    ("properties", Json.Object [
      ("code", str "Unison source (check, update, diff, type-search) or the body of a do block (run without name)."),
      ("action", Json.Object [("type", Json.Text "string"), ("enum", actions), ("description", Json.Text "What to do; default check.")]),
      ("topic", str "For action guide: unison-basics, http-json, mcp-client, oauth, cdp, process-ffi, traps (default: index plus unison-basics and traps)."),
      ("name", str "Definition name(s), search query, library project, tests subnamespace or raw tool name, depending on action."),
      ("args", Json.Object [("type", Json.Text "array"), ("items", Json.Object [("type", Json.Text "string")]), ("description", Json.Text "Arguments of the run main function, or [branch] for install.")]),
      ("json", str "Raw JSON arguments for action tool."),
      ("timeout_ms", Json.Object [("type", Json.Text "integer"), ("description", Json.Text "Per-call timeout in milliseconds; default 120000.")]),
      ("project", str "Project name; default main."),
      ("branch", str "Branch name; default main.")])]

Server.toolDef : Json
Server.toolDef = Json.Object [("name", Json.Text Server.toolName), ("description", Json.Text Server.description), ("inputSchema", Server.schema)]

-- ---------- classification and formatting ----------

Server.classify : Text -> Text
Server.classify t =
  has s = Text.contains s t
  if has "I couldn't figure out what" && has "ambiguous" then "ambiguous-name"
  else if has "I couldn't figure out what" || has "were not found" || has "couldn't find a function" || has "I couldn't find" then "wrong-name"
  else if has "I found a value" && has "where I expected" then "type-mismatch"
  else if has "needs the {" || has "needs the  {" then "unhandled-ability"
  else if has "I got confused here" || has "I was surprised" then "parse-error"
  else if has "ambiguous" then "ambiguous-name"
  else "error"

Server.header : Text -> Boolean -> Text -> Text
Server.header stage ok cls =
  "stage: " ++ stage ++ "\nok: " ++ (if ok then "true" else "false") ++ "\nclass: " ++ cls ++ "\n\n"

Server.contentText : Json -> Text
Server.contentText r = match Jx.get "content" r with
  Some (Json.Array items) -> Text.join "\n" (List.filterMap (Jx.getText "text") items)
  _ -> Json.toText r

Server.isErrorFlag : Json -> Boolean
Server.isErrorFlag r = match Jx.get "isError" r with
  Some (Json.Boolean b) -> b
  _ -> false

Server.noise : Text -> Boolean
Server.noise m = Text.startsWith "Loading changes detected" m || Text.trim m == "No changes found."

-- a ucm tool result (JSON text inside content) as stage/ok/class header plus messages
Server.report : Text -> Json -> (Boolean, Text)
Server.report stage r =
  txt = Server.contentText r
  flag = Server.isErrorFlag r
  match Exception.catch do Json.fromText txt with
    Right j | Jx.get "errorMessages" j !== None ->
      errs = Jx.getTexts "errorMessages" j
      outs = List.filter (m -> not (Server.noise m)) (Jx.getTexts "outputMessages" j)
      extra = List.filter (s -> Text.size (Text.trim s) > 0) (List.filterMap (k -> Jx.getText k j) ["stdout", "stderr"])
      ok = List.size errs == 0 && not flag
      body = if ok then outs List.++ extra else errs List.++ extra
      cls = if ok then "none" else Server.classify (Text.join "\n" errs)
      (ok, Server.header stage ok cls ++ Text.join "\n\n" body)
    _ ->
      cls = if flag then Server.classify txt else "none"
      (not flag, Server.header stage (not flag) cls ++ txt)

Server.failText : Nat -> Stdio.Error -> Text
Server.failText ms = cases
  Stdio.Error.Timeout -> Server.header "unison" false "timeout" ++ "no reply within " ++ Nat.toText ms ++ " ms; the ucm child was killed and restarts on the next call"
  Stdio.Error.Dead why -> Server.header "unison" false "child-died" ++ "ucm child died (" ++ why ++ "); it restarts on the next call"
  Stdio.Error.Rpc j -> Server.header "unison" false "rpc-error" ++ Json.toText j

-- ---------- calling the child ----------

Server.callTool : Stdio.Child -> Nat -> Nat -> Text -> Json ->{IO} Either Stdio.Error Json
Server.callTool c ms id tool arguments =
  Stdio.call c ms (Json.nat id) "tools/call" (Json.Object [("name", Json.Text tool), ("arguments", arguments)])

Server.pc : Server.Config -> Json -> Json
Server.pc cfg args =
  p = match Jx.getText "project" args with
    Some x -> x
    None -> Server.Config.project cfg
  b = match Jx.getText "branch" args with
    Some x -> x
    None -> Server.Config.branch cfg
  Json.Object [("projectName", Json.Text p), ("branchName", Json.Text b)]

Server.indent : Text -> Text
Server.indent code = Text.join "\n" (List.map (l -> "  " ++ l) (Text.lines code))

Server.cellName : Text
Server.cellName = "scratch.mcpCell"

-- ---------- guide ----------

Server.topicBody : Text -> Text
Server.topicBody t = match List.find (cases (n, _) -> n == t) Guide.topics with
  Some (_, b) -> b
  None -> ""

Server.guideDefault : Text
Server.guideDefault =
  Server.header "guide" true "none" ++ "Topics (call action 'guide' with 'topic'): " ++ Text.join ", " (List.map (cases (n, _) -> n) Guide.topics) ++ ", language (ucm's own language guide).\n\n" ++ Server.topicBody "unison-basics" ++ "\n\n" ++ Server.topicBody "traps"

-- ---------- run cells with definitions ----------

Server.dropBlank : [Text] -> [Text]
Server.dropBlank = cases
  [] -> []
  h +: t -> if Text.size (Text.trim h) == 0 then Server.dropBlank t else h +: t

Server.tokens : Text -> [Text]
Server.tokens l = List.filter (s -> Text.size s > 0) (Text.split ?\s l)

Server.col0 : Text -> Boolean
Server.col0 l = Text.size l > 0 && not (Text.startsWith " " l) && not (Text.startsWith "\t" l)

-- a top-level type signature or declaration line (a do-block body has none)
Server.isDefLine : Text -> Boolean
Server.isDefLine l =
  if not (Server.col0 l) then false
  else
    toks = Server.tokens l
    first = Optional.getOrElse "" (List.head toks)
    second = Optional.getOrElse "" (List.head (List.drop 1 toks))
    if first === "type" || first === "unique" || first === "structural" || first === "ability" then true
    else second === ":" && not (Text.startsWith ">" l)

-- Some (definitions, final expression) when the cell is a program: it has definitions and ends with `> expr` or a bare expression
Server.splitProgram : Text -> Optional (Text, Text)
Server.splitProgram code =
  ls = Text.lines code
  if List.find Server.isDefLine ls === None then None
  else match List.reverse (Server.dropBlank (List.reverse ls)) with
    [] -> None
    all ->
      lastLine = Optional.getOrElse "" (List.last all)
      body = Text.join "\n" (List.take (List.size all - 1) all)
      if Text.startsWith "> " lastLine then Some (body, Text.drop 2 lastLine)
      else if Server.col0 lastLine && not (Text.startsWith "--" lastLine) && not (Text.startsWith "test>" lastLine) && not (Text.contains " = " lastLine) && not (Server.isDefLine lastLine) then Some (body, lastLine)
      else None

Server.progNs : Text
Server.progNs = "scratch.mcpRun"

Server.progEntry : Text
Server.progEntry = "scratch.mcpRun.mcpEntry"

-- ---------- big results ----------

Server.capChars : Nat
Server.capChars = 12000

Server.stamp : '{IO, Exception} Text
Server.stamp = do
  (i, o, e, p) = Process.start "date" ["+%Y%m%dT%H%M%S"]
  t = Text.trim (getText o)
  _ = Process.wait p
  t

-- keep a reply under capChars: head and tail, the full text in a file under ~/.local/share/uni/spill
Server.cap : Nat -> Text ->{IO} Text
Server.cap seq t =
  if Text.size t <= Server.capChars then t
  else
    n = Text.size t
    head = Text.take 7000 t
    tail = Text.drop (n - 4000) t
    spill = do
      dir = IO.getEnv "HOME" ++ "/.local/share/uni/spill"
      (i, o, e, p) = Process.start "mkdir" ["-p", dir]
      _ = Process.wait p
      path = dir ++ "/" ++ !Server.stamp ++ "-" ++ Nat.toText seq ++ ".txt"
      writeFileUtf8 (FilePath path) t
      path
    note = match Exception.catch spill with
      Right path -> "full text (" ++ Nat.toText n ++ " characters) in file: " ++ path
      Left f -> "full text not saved (" ++ Jx.message f ++ ")"
    head ++ "\n\n[... cut, " ++ note ++ " ...]\n\n" ++ tail

-- run one tool and format it
Server.step : Text -> Stdio.Child -> Nat -> Nat -> Text -> Json ->{IO} Either Stdio.Error (Boolean, Text)
Server.step stage c ms id tool arguments = match Server.callTool c ms id tool arguments with
  Left e -> Left e
  Right r -> Right (Server.report stage r)

Server.reqText : Text -> Json ->{Exception} Text
Server.reqText k args = Jx.need ("input '" ++ k ++ "'") (Jx.getText k args)

Server.splitNames : Text -> [Text]
Server.splitNames t = List.filter (s -> Text.size s > 0) (Text.split ?\s (Text.join " " (Text.split ?, t)))

-- the action dispatcher: Right (ok, text) or a transport error
Server.act : Server.Config -> Stdio.Child -> Nat -> Json ->{IO} Either Stdio.Error Text
Server.act cfg c seq args =
  ms = match Jx.getNat "timeout_ms" args with
    Some n -> n
    None -> Server.Config.timeoutMs cfg
  base = seq * 10
  pc = Server.pc cfg args
  action = match Jx.getText "action" args with
    Some a -> a
    None -> "check"
  code = Jx.getText "code" args
  name = Jx.getText "name" args
  fin = cases
    Left e -> Left e
    Right (_, t) -> Right t
  need k = match Exception.catch do Server.reqText k args with
    Right t -> Right t
    Left f -> Left (Stdio.Error.Dead (Jx.message f))
  usage msg = Right (Server.header action false "usage" ++ msg)
  match action with
    "check" -> match code with
      None -> usage "check needs 'code'"
      Some src -> fin (Server.step "typecheck" c ms base "typecheck-code" (Json.Object [("projectContext", pc), ("code", Json.Object [("sourceCode", Json.Text src)])]))
    "update" -> match code with
      None -> usage "update needs 'code'"
      Some src -> fin (Server.step "update" c ms base "update-definitions" (Json.Object [("projectContext", pc), ("code", Json.Object [("sourceCode", Json.Text src)])]))
    "diff" -> match code with
      None -> usage "diff needs 'code'"
      Some src -> fin (Server.step "diff" c ms base "diff-update" (Json.Object [("projectContext", pc), ("code", Json.Object [("text", Json.Text src)])]))
    "run" ->
      runArgs = Json.Array (List.map Json.Text (Jx.getTexts "args" args))
      runName n = Server.step "run" c ms (base + 2) "run" (Json.Object [("projectContext", pc), ("mainFunctionName", Json.Text n), ("args", runArgs)])
      match (name, code) with
        (Some n, None) -> fin (runName n)
        (Some n, Some src) -> match Server.step "update" c ms base "update-definitions" (Json.Object [("projectContext", pc), ("code", Json.Object [("sourceCode", Json.Text src)])]) with
          Left e -> Left e
          Right (false, t) -> Right t
          Right (true, _) -> fin (runName n)
        (None, Some body) -> match Server.splitProgram body with
         Some (defs, expr) ->
          cell = "namespace " ++ Server.progNs ++ "\n\n" ++ defs ++ "\n\nmcpEntry = do\n" ++ Server.indent expr ++ "\n"
          match Server.step "update" c ms base "update-definitions" (Json.Object [("projectContext", pc), ("code", Json.Object [("sourceCode", Json.Text cell)])]) with
            Left e -> Left e
            Right (false, t) -> Right t
            Right (true, _) ->
              r = runName Server.progEntry
              match r with
                Left e -> Left e
                Right _ ->
                  _ = Server.callTool c 30000 (base + 4) "delete-definitions" (Json.Object [("projectContext", pc), ("names", Json.Array [Json.Text Server.progEntry]), ("force", Json.Boolean true)])
                  fin r
         None ->
          cell = Server.cellName ++ " = do\n" ++ Server.indent body ++ "\n"
          match Server.step "update" c ms base "update-definitions" (Json.Object [("projectContext", pc), ("code", Json.Object [("sourceCode", Json.Text cell)])]) with
            Left e -> Left e
            Right (false, t) -> Right t
            Right (true, _) ->
              r = runName Server.cellName
              -- clean up the scratch cell only when the child is still usable (never after a timeout)
              match r with
                Left e -> Left e
                Right _ ->
                  _ = Server.callTool c 30000 (base + 4) "delete-definitions" (Json.Object [("projectContext", pc), ("names", Json.Array [Json.Text Server.cellName]), ("force", Json.Boolean true)])
                  fin r
        (None, None) -> usage "run needs 'name' or 'code'"
    "view" -> match need "name" with
      Left e -> Left e
      Right n -> fin (Server.step "view" c ms base "view-definitions" (Json.Object [("projectContext", pc), ("names", Json.Array (List.map Json.Text (Server.splitNames n)))]))
    "search" -> match need "name" with
      Left e -> Left e
      Right n -> fin (Server.step "search" c ms base "search-definitions-by-name" (Json.Object [("projectContext", pc), ("query", Json.Text n)]))
    "type-search" ->
      q = match name with
        Some n -> Some n
        None -> code
      match q with
        None -> usage "type-search needs 'name' or 'code' (a type)"
        Some t -> fin (Server.step "type-search" c ms base "search-by-type" (Json.Object [("projectContext", pc), ("query", Json.Text t)]))
    "install" -> match need "name" with
      Left e -> Left e
      Right n ->
        branch = match List.head (Jx.getTexts "args" args) with
          Some b -> Json.Text b
          None -> Json.Null
        fin (Server.step "install" c ms base "lib-install" (Json.Object [("projectContext", pc), ("libProjectName", Json.Text n), ("libBranchName", branch)]))
    "docs" -> match need "name" with
      Left e -> Left e
      Right n -> fin (Server.step "docs" c ms base "docs" (Json.Object [("projectContext", pc), ("name", Json.Text n)]))
    "tests" ->
      sub = match name with
        Some n -> Json.Text n
        None -> Json.Null
      fin (Server.step "tests" c ms base "run-tests" (Json.Object [("projectContext", pc), ("subnamespace", sub)]))
    "guide" -> match Jx.getText "topic" args with
      None -> Right (Server.guideDefault)
      Some "language" -> match Stdio.call c ms (Json.nat base) "resources/read" (Json.Object [("uri", Json.Text "file://unison-guide")]) with
        Left e -> Left e
        Right r -> match Jx.get "contents" r with
          Some (Json.Array items) -> Right (Text.join "\n" (List.filterMap (Jx.getText "text") items))
          _ -> Right (Json.toText r)
      Some t -> match List.find (cases (n, _) -> n == t) Guide.topics with
        Some (_, body) -> Right (Server.header "guide" true "none" ++ body)
        None -> usage ("unknown topic '" ++ t ++ "'; topics: " ++ Text.join ", " (List.map (cases (n, _) -> n) Guide.topics) ++ ", language")
    "tools" -> match Stdio.call c ms (Json.nat base) "tools/list" (Json.Object []) with
      Left e -> Left e
      Right r -> match Jx.get "tools" r with
        Some (Json.Array ts) -> Right (Text.join "\n" (List.filterMap (Jx.getText "name") ts))
        _ -> Right (Json.toText r)
    "tool" -> match need "name" with
      Left e -> Left e
      Right n ->
        raw = match Jx.getText "json" args with
          Some j -> Exception.catch do Json.fromText j
          None -> Right (Json.Object [])
        match raw with
          Left f -> usage ("json is not valid JSON: " ++ Jx.message f)
          Right (Json.Object kvs) ->
            withPc = match Jx.get "projectContext" (Json.Object kvs) with
              Some _ -> kvs
              None -> kvs List.++ [("projectContext", pc)]
            fin (Server.step n c ms base n (Json.Object withPc))
          Right _ -> usage "json must be an object"
    other -> usage ("unknown action '" ++ other ++ "'")

-- start (or restart) the ucm child when it is missing or dead
Server.ensure : Server.Config -> Optional Stdio.Child ->{IO} Either Stdio.Error Stdio.Child
Server.ensure cfg child =
  start = do Stdio.start (Server.Config.ucm cfg) ["mcp", "-C", Server.Config.codebase cfg] 120000
  match child with
    Some c ->
      if Stdio.isAlive c then Right c
      else
        Stdio.stop c
        !start
    None -> !start

-- one tool call: supervise the child, never let a transport failure escape
Server.exec : Server.Config -> Optional Stdio.Child -> Nat -> Json -> (Server.Out, Optional Stdio.Child)
Server.exec cfg child seq args =
  ms = match Jx.getNat "timeout_ms" args with
    Some n -> n
    None -> Server.Config.timeoutMs cfg
  match Server.ensure cfg child with
    Left e -> (Server.Out.Out true (Server.failText ms e), None)
    Right c -> match Server.act cfg c seq args with
      Left e ->
        Stdio.stop c
        (Server.Out.Out true (Server.failText ms e), None)
      Right text -> (Server.Out.Out false (Server.cap seq text), Some c)

-- ---------- JSON-RPC server ----------

Server.protocol : Json -> Text
Server.protocol params = match Jx.getText "protocolVersion" params with
  Some v -> v
  None -> "2025-03-26"

Server.initResult : Json -> Json
Server.initResult params = Json.Object [
  ("protocolVersion", Json.Text (Server.protocol params)),
  ("capabilities", Json.Object [("tools", Json.Object [])]),
  ("serverInfo", Json.Object [("name", Json.Text "unison"), ("version", Json.Text "0.1.0")]),
  ("instructions", Json.Text "One tool, 'unison'. Read its description; use action 'guide' for the language guide.")]

Server.toolResult : Server.Out -> Json
Server.toolResult = cases Server.Out.Out isErr text ->
  Json.Object [("content", Json.Array [Json.Object [("type", Json.Text "text"), ("text", Json.Text text)]]), ("isError", Json.Boolean isErr)]

Server.reply : Text ->{IO, Exception} ()
Server.reply line = putText stdOut (line ++ "\n")

-- process one request line; returns the (possibly restarted) child
Server.onLine : Server.Config -> Optional Stdio.Child -> Nat -> Text ->{IO, Exception} Optional Stdio.Child
Server.onLine cfg child seq line = match Exception.catch do Json.fromText line with
  Left _ ->
    Server.reply (Jx.errorResponse Json.Null -32700 "parse error")
    child
  Right msg ->
    method = match Jx.getText "method" msg with
      Some m -> m
      None -> ""
    params = match Jx.get "params" msg with
      Some p -> p
      None -> Json.Object []
    match Jx.get "id" msg with
      None -> child
      Some id -> match method with
        "initialize" ->
          Server.reply (Jx.response id (Server.initResult params))
          child
        "ping" ->
          Server.reply (Jx.response id (Json.Object []))
          child
        "tools/list" ->
          Server.reply (Jx.response id (Json.Object [("tools", Json.Array [Server.toolDef])]))
          child
        "tools/call" ->
          if Jx.getText "name" params === Some Server.toolName then
            args = match Jx.get "arguments" params with
              Some a -> a
              None -> Json.Object []
            (out, child2) = Server.exec cfg child seq args
            Server.reply (Jx.response id (Server.toolResult out))
            child2
          else
            Server.reply (Jx.errorResponse id -32602 "unknown tool; the only tool is 'unison'")
            child
        _ ->
          Server.reply (Jx.errorResponse id -32601 ("method not found: " ++ method))
          child

Server.loop : Server.Config -> Optional Stdio.Child -> Nat ->{IO, Exception} ()
Server.loop cfg child seq = match Exception.catch do getLine stdIn with
  Left _ -> match child with
    Some c -> Stdio.stop c
    None -> ()
  Right line ->
    if Text.size (Text.trim line) == 0 then Server.loop cfg child seq
    else Server.loop cfg (Server.onLine cfg child seq line) (seq + 1)

-- Environment: UNISON_MCP_UCM (path of the `unison` binary of the pinned ucm), UNISON_MCP_CODEBASE
-- (codebase directory), optional UNISON_MCP_PROJECT / UNISON_MCP_BRANCH (default main/main) and
-- UNISON_MCP_TIMEOUT_MS (default 120000).
Server.main : '{IO, Exception} ()
Server.main = do
  setBuffering stdOut NoBuffering
  ucm = Server.env "UNISON_MCP_UCM" "ucm"
  cb = Server.env "UNISON_MCP_CODEBASE" ""
  cfg = Server.Config.Config ucm cb (Server.env "UNISON_MCP_PROJECT" "main") (Server.env "UNISON_MCP_BRANCH" "main") (Optional.getOrElse 120000 (Nat.fromText (Server.env "UNISON_MCP_TIMEOUT_MS" "120000")))
  Server.loop cfg None 1
